# ICD工具原型 后端环境变量示例
# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 忽略
# 真实 API Key、Base URL、Model Name 由部署方自行维护

# ----------------------------------------------------------------------------
# 账号库与登录鉴权（必填；缺失会导致后端启动失败）
# ----------------------------------------------------------------------------
# MongoDB 连接串。本地直接跑 uvicorn 时用 127.0.0.1；docker compose 会在
# 容器的 environment 中覆盖为 mongodb://mongo:27017/icd，无需手工改本项。
MONGO_URL=mongodb://127.0.0.1:27017/icd
# 数据库名（用户集合所在库，集合名固定为 users）
MONGO_DB=icd
# JWT 签名密钥：至少 32 个字符，必须自行生成随机串，不得留空。
# 生成示例：openssl rand -hex 32
AUTH_JWT_SECRET=
# 登录有效期（秒），默认 8 小时（28800）
AUTH_TOKEN_TTL_SECONDS=28800
# 登录 Cookie 名称
AUTH_COOKIE_NAME=icd_auth
# Cookie 是否仅通过 HTTPS 传输：内网 HTTP 部署填 0；启用 TLS 后改为 1
AUTH_COOKIE_SECURE=0
# 初始管理员：仅在用户集合为空（首次启动）时用于创建管理员；
# 已有账号后这两项被忽略。密码至少 8 位，上线后请立即在页面重置一次。
ICD_ADMIN_USERNAME=
ICD_ADMIN_PASSWORD=
# 是否开放 /docs、/redoc、/openapi.json：开发默认 1，服务器部署由 compose 设为 0
ICD_DOCS_ENABLED=1

# Mongo 容器内存上限（服务器 docker-compose.server.yml 使用）。该变量属于
# 部署目录根 .env 的 compose 变量替换，不是 backend/.env 的配置项；此处列出
# 仅为说明默认值，默认 1g。物理内存不足时按 部署说明.md §5.4 重新计算。
MONGO_MEM_LIMIT=1g

# 是否使用 Mock LLM（1=mock，0=真实）
USE_MOCK_LLM=1

# 多模型裁判 provider 白名单，逗号分隔；每个列出的 provider 必须有对应 API Key
JUDGE_PROVIDERS=deepseek,minimax,qwen

# Mock 裁判预设结论（covered / inconsistent / needs_review），仅 USE_MOCK_LLM=1 时生效
MOCK_JUDGE_RESULT=covered

# 正向多 judge 运行参数（可选）：单 judge 软预算秒数 / 整轮墙钟上限秒数（0=不限）
# FORWARD_JUDGE_TIMEOUT=3600
# FORWARD_TOTAL_TIMEOUT=0

# 反向管线单次模型请求超时（秒）：作用于 HLR 标注 / 多模型裁判 / 共识 / 复盘
# 全部调用。默认 120（与历史行为一致）；内网网关较慢出现偶发 ReadTimeout 时
# 可调大（如 240，需小于 DEGRADATION_CASE_TIMEOUT）。未配置或非法值回落 120；
# 截断重试会以此值为基数自动 ×2。
LLM_TIMEOUT=120

# ----------------------------------------------------------------------------
# 反向管线各 provider 的思考模式默认开关（1=开启，0=关闭；默认开启）
# ----------------------------------------------------------------------------
# 前端「模型设置」页保存后会在运行时覆盖这三个值，通常无需改本文件。
# DeepSeek 开启时使用 reasoning_effort=low；Qwen / MiniMax 开启时不额外发送参数。
# MiniMax 通道按 Qwen 兼容协议发送 enable_thinking=false，是否生效取决于
# MINIMAX_BASE_URL 指向的接口。
# DEEPSEEK_THINKING=1
# MINIMAX_THINKING=1
# QWEN_THINKING=1

# ----------------------------------------------------------------------------
# 任务队列（多输入批量并行）
# ----------------------------------------------------------------------------
# 同一时刻最多并行运行的分析任务数，默认 2
# （2C2G 服务器单任务峰值 300~500MB，调大前先确认内存；内存更小可设为 1）
MAX_CONCURRENT_JOBS=2

# ----------------------------------------------------------------------------
# DeepSeek 配置（HLR 标注 + 多模型裁判 + Review Agent 均使用）
# ----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ----------------------------------------------------------------------------
# MiniMax 配置（可选；未配置 Key 时从 JUDGE_PROVIDERS 中移除）
# ----------------------------------------------------------------------------
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_MODEL=MiniMax-M2.5

# ----------------------------------------------------------------------------
# Qwen 配置 (DashScope，可选；未配置 Key 时从 JUDGE_PROVIDERS 中移除)
# ----------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-35b-a3b

# ----------------------------------------------------------------------------
# 降级机制配置（Multi-Agent Degradation）
# ----------------------------------------------------------------------------
# Case 级超时兜底上限（秒），当不足 2 个 provider 完成时作为等待截止时间，默认300
DEGRADATION_CASE_TIMEOUT=300
# 第三个 provider 在第二个完成后额外等待时间（秒），默认 240
DEGRADATION_EXTRA_WAIT=240
# 超时任务后台收尾：join 迟到裁判结果的总预算（秒），默认300
DEGRADATION_DRAIN_BUDGET=300
# 后台收尾线程池大小，默认6
DEGRADATION_DRAIN_WORKERS=6
# 后台收尾最大任务数，超过后取消（TIMEOUT 占位保留），默认60
DEGRADATION_DRAIN_MAX_TASKS=60
# 最大同时提交到线程池的任务数（信号量限流），默认6
DEGRADATION_MAX_INFLIGHT=6
# 连续失败 N 次后标记 provider 为 unhealthy，默认3
DEGRADATION_CONSECUTIVE_FAILURES=3
# unhealthy provider 自动恢复 TTL（秒），默认300
DEGRADATION_UNHEALTHY_TTL=300
