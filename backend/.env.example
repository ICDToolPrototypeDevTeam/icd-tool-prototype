# ICD工具原型Ver2.0 后端环境变量示例
# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 忽略
# 真实 API Key、Base URL、Model Name 由部署方自行维护

# 是否使用 Mock LLM（1=mock，0=真实）
USE_MOCK_LLM=1

# CrewAI 详细日志开关（1=开，0=关，默认 0）
CREWAI_VERBOSE=0

# ----------------------------------------------------------------------------
# MiniMax 配置
# ----------------------------------------------------------------------------
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=
MINIMAX_PROVIDER=
MINIMAX_TEMPERATURE=
MINIMAX_TOP_P=
MINIMAX_MAX_TOKENS=
MINIMAX_TIMEOUT=
MINIMAX_MAX_RETRIES=
MINIMAX_RETRY_BACKOFF=
MINIMAX_STREAM=

# ----------------------------------------------------------------------------
# DeepSeek 配置
# ----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_PROVIDER=
DEEPSEEK_TEMPERATURE=
DEEPSEEK_TOP_P=
DEEPSEEK_MAX_TOKENS=
DEEPSEEK_TIMEOUT=
DEEPSEEK_MAX_RETRIES=
DEEPSEEK_RETRY_BACKOFF=
DEEPSEEK_STREAM=

# ----------------------------------------------------------------------------
# Qwen 配置 (DashScope)
# ----------------------------------------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_PROVIDER=
QWEN_TEMPERATURE=
QWEN_TOP_P=
QWEN_MAX_TOKENS=
QWEN_TIMEOUT=
QWEN_MAX_RETRIES=
QWEN_RETRY_BACKOFF=
QWEN_STREAM=
