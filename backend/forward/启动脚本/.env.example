# 复制本文件为 .env 并填入你的真实 AI Key
# .env 已被 .gitignore 忽略，绝不会入库；请勿把真实 Key 写进其它被跟踪的文件
# 行尾不要留空格；等号前后不要留空格（API_KEY=sk-xxxx）

API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- AI 连接配置（代码已无内置默认，三项均必填）----
# 切换模型/端点只改下面两行即可
BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 优先级：命令行参数 > 环境变量 > ai_config.json
